# In .env kopieren und mit den Werten des DEV-Projekts fuellen.
# NUR der anon-Key gehoert hierher — der service_role-Key NIEMALS
# (nicht in den Client, nicht ins Repo, nicht in Logs).
EXPO_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=DEIN-ANON-KEY

# On-Device-Foto-Pruefung (docs/vision-ondevice.md). "0" schaltet sie im
# Build komplett ab; sonst entscheidet das aktive Modell in vision_models.
EXPO_PUBLIC_ONDEVICE_VISION=1

# Demo-Modus fuer das Pitch-Video (src/app/demo). In Entwicklungs-Builds immer
# erreichbar; in Release-Builds nur mit "1". Fuer Store-Builds leer lassen.
EXPO_PUBLIC_DEMO=
