{
  "expo": {
    "name": "CLAR",
    "slug": "clarr-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarrapp",
    "userInterfaceStyle": "automatic",
    "locales": {
      "de": "./assets/locales/de.json",
      "en": "./assets/locales/en.json"
    },
    "ios": {
      "bundleIdentifier": "app.clar.mobile",
      "buildNumber": "1",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "CLAR nutzt die Kamera, damit du den gefundenen Müll direkt vor Ort fotografieren kannst. Das Foto gehört zur Meldung; veröffentlicht wird nur eine Kopie, in der Gesichter und Kennzeichen unkenntlich gemacht sind.",
        "NSPhotoLibraryUsageDescription": "CLAR greift auf deine Fotos zu, damit du für eine Meldung ein bereits vorhandenes Bild auswählen kannst. Wir lesen nur das Bild, das du aussuchst, und entfernen vor dem Hochladen Ort und Zeit aus den Bilddaten.",
        "NSLocationWhenInUseUsageDescription": "CLAR nutzt deinen Standort nur während du die App benutzt, um den Fundort einer Müllmeldung zu erfassen. Auf der öffentlichen Karte wird der Ort gerundet angezeigt, nicht als exakter Punkt. Es findet keine Standortverfolgung im Hintergrund statt.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "app.clar.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C8146",
          "dark": {
            "backgroundColor": "#0E5A2F"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-fast-tflite",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
