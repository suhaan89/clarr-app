{
  "expo": {
    "name": "clarr-app",
    "slug": "clarr-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "clarrapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "CLAR nutzt die Kamera, um Fotos von gemeldetem Müll direkt vor Ort aufzunehmen.",
        "NSPhotoLibraryUsageDescription": "CLAR braucht Zugriff auf deine Fotomediathek, damit du beim Melden ein vorhandenes Foto auswählen kannst.",
        "NSLocationWhenInUseUsageDescription": "CLAR nutzt deinen Standort, um den genauen Ort einer Müllmeldung zu erfassen."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C8146",
          "dark": {
            "backgroundColor": "#0E5A2F"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "react-native-fast-tflite",
      "expo-secure-store"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
