deno.lock

# Nur fuer EAS Build: was die App nicht braucht, bleibt hier.
# (.easignore ersetzt .gitignore beim Hochladen, deshalb steht oben dessen Inhalt.
# Wer .gitignore aendert, zieht diese Datei nach.)
/training/
/supabase/
/docs/
/.claude/
/.github/
